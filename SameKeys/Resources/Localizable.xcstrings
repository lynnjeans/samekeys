        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SameKeys는 다운로드된 폴더에서는 업데이트할 수 없습니다. 응용 프로그램 폴더로 옮긴 다음 거기서 여십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SameKeys nie może się uaktualnić w folderze, do którego go pobrano. Przenieś go do katalogu Aplikacje i otwórz go stamtąd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O SameKeys não pode ser atualizado a partir da pasta em que foi baixado. Mova-o para a pasta Aplicativos e abra-o de lá."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SameKeys 留在下载时所在的文件夹里无法更新。请把它移到“应用程序”文件夹，再从那里打开。"
