    "Unavailable until SameKeys has the permissions below. macOS does not let an app change shortcuts without them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht verfügbar, bis SameKeys die Berechtigungen unten hat. Ohne sie lässt macOS keine App Kurzbefehle ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No disponible hasta que SameKeys tenga los permisos de abajo. Sin ellos, macOS no deja que una app cambie atajos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indisponible tant que SameKeys n’a pas les autorisations ci-dessous. Sans elles, macOS ne laisse aucune app modifier les raccourcis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下の権限が許可されるまで使えません。これらがないと、macOS はアプリにショートカットの変更を許可しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SameKeys에 아래 권한이 있어야 사용할 수 있습니다. 권한이 없으면 macOS가 앱이 단축키를 바꾸지 못하게 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedostępne, dopóki SameKeys nie ma poniższych uprawnień. Bez nich macOS nie pozwala aplikacji zmieniać skrótów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indisponível até o SameKeys ter as permissões abaixo. Sem elas, o macOS não deixa um app mudar atalhos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要先授予下面的权限。没有这些权限，macOS 不允许应用更改快捷键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
