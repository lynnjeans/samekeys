    "Shows or hides the clipboard history, as its own shortcut does. Does nothing while the history is off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet den Zwischenablage-Verlauf ein oder aus, wie sein eigener Kurzbefehl. Tut nichts, solange der Verlauf aus ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra u oculta el historial del portapapeles, como su propio atajo. No hace nada mientras el historial está desactivado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche ou masque l’historique du presse-papiers, comme son propre raccourci. Ne fait rien tant que l’historique est désactivé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップボード履歴を表示または非表示にします（履歴のショートカットと同じ）。履歴がオフのときは何もしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자체 단축키처럼 클립보드 기록을 보이거나 숨깁니다. 기록이 꺼져 있으면 아무 동작도 하지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje lub ukrywa historię schowka, jak jej własny skrót. Nic nie robi, gdy historia jest wyłączona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra ou oculta o histórico da área de transferência, como o próprio atalho dele. Não faz nada enquanto o histórico está desativado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示或隐藏剪贴板历史，和它自己的快捷键一样。剪贴板历史关闭时不起作用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示或隱藏剪貼簿歷史，和它自己的快速鍵一樣。剪貼簿歷史關閉時不起作用。"
          }
        }
      }
    },
