        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離開密碼欄位後就會恢復。"
          }
        }
      }
    },
    "It has been on for a while, so it is probably not a password field." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie ist schon eine Weile an, es ist also wohl kein Passwortfeld."
