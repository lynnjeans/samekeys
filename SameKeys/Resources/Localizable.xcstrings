          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg jede Tastenkombination oder Maustaste auf einen anderen Kurzbefehl oder eine App – zum Beispiel fn+C auf ⌘C neben Strg+C oder Win+E auf den Finder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asigna cualquier combinación de teclas o botón del ratón a otro atajo o a una app; por ejemplo, fn+C a ⌘C además de Ctrl+C, o Win+E al Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associez n’importe quelle combinaison de touches ou bouton de souris à un autre raccourci ou à une app — par exemple fn+C vers ⌘C en plus de Ctrl+C, ou Win+E vers le Finder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意のキーの組み合わせやマウスボタンを、別のショートカットやアプリに割り当てられます。たとえば Ctrl+C に加えて fn+C も ⌘C に、Win+E で Finder を開く、など。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 키 조합이나 마우스 버튼이든 다른 단축키나 앱에 연결하십시오. 예를 들어 Ctrl+C 외에 fn+C도 ⌘C로, 또는 Win+E로 Finder를 엽니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypisz dowolną kombinację klawiszy lub przycisk myszy do innego skrótu albo aplikacji — np. fn+C do ⌘C obok Ctrl+C albo Win+E do Findera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapeie qualquer combinação de teclas ou botão do mouse para outro atalho ou para um app — por exemplo, fn+C para ⌘C além de Ctrl+C, ou Win+E para o Finder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把任意组合键或鼠标键映射到另一个快捷键或某个应用——比如在 Ctrl+C 之外再让 fn+C 变成 ⌘C，或让 Win+E 打开访达。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把任意組合鍵或滑鼠按鈕對應到另一個快速鍵或某個 App——比如在 Ctrl+C 之外再讓 fn+C 變成 ⌘C，或讓 Win+E 打開 Finder。"
          }
        }
      }
    },
