    "This keyboard has no fn key, so Ctrl shortcuts are pressed with Ctrl, as on Windows. For example, Ctrl+C copies." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Tastatur hat keine fn-Taste, Strg-Kurzbefehle drückst du also mit Strg, wie unter Windows. Zum Beispiel kopiert Strg+C."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este teclado no tiene tecla fn, así que los atajos con Ctrl se pulsan con Ctrl, como en Windows. Por ejemplo, Ctrl+C copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce clavier n’a pas de touche fn, les raccourcis Ctrl se font donc avec Ctrl, comme sous Windows. Par exemple, Ctrl+C copie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このキーボードには fn キーがないため、Ctrl ショートカットは Windows と同じく Ctrl で押します。例：Ctrl+C でコピー。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 키보드에는 fn 키가 없으므로 Ctrl 단축키를 Windows처럼 Ctrl로 누릅니다. 예를 들어 Ctrl+C로 복사합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta klawiatura nie ma klawisza fn, więc skróty z Ctrl naciskasz z Ctrl, jak w Windows. Na przykład Ctrl+C kopiuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este teclado não tem tecla fn, então os atalhos com Ctrl são pressionados com Ctrl, como no Windows. Por exemplo, Ctrl+C copia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这把键盘没有 fn 键，Ctrl 快捷键和在 Windows 上一样用 Ctrl 按。例如 Ctrl+C 复制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個鍵盤沒有 fn 鍵，Ctrl 快速鍵和在 Windows 上一樣用 Ctrl 按。例如 Ctrl+C 拷貝。"
          }
        }
      }
    },
