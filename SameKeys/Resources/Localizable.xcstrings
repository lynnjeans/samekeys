    "SameKeys starts when you log in, so your shortcuts work right after a restart." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SameKeys startet bei der Anmeldung, damit deine Kurzbefehle gleich nach einem Neustart gehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SameKeys se abre al iniciar sesión, para que tus atajos funcionen nada más reiniciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SameKeys démarre à l’ouverture de session, pour que vos raccourcis marchent dès un redémarrage."
          }
        },
        "ja" : {
          "stringUnit" : {
