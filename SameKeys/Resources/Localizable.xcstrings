    },
    "Also used by %@. Only one of them takes effect." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird auch von „%@“ genutzt. Nur eins davon wirkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También lo usa “%@”. Solo uno de los dos funciona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aussi utilisé par « %@ ». Un seul des deux s’applique."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」でも使われています。有効になるのはどちらか一方だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’도 사용합니다. 둘 중 하나만 적용됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używa go też „%@”. Działa tylko jedno z nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também usado por “%@”. Só um deles funciona."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”也使用了它，只有其中一个会生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」也使用了它，只有其中一個會生效。"
          }
        }
      }
    },
    "An app has turned on Secure Input, which hides key presses from apps like SameKeys — a macOS safeguard for passwords, not a fault. Mouse buttons and scrolling still work." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine App hat die sichere Eingabe aktiviert, die Tastendrücke vor Apps wie SameKeys verbirgt – ein Schutz von macOS für Passwörter, kein Fehler. Maustasten und Scrollen funktionieren weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una app ha activado la entrada segura, que oculta las pulsaciones a apps como SameKeys: una protección de macOS para contraseñas, no un fallo. Los botones del ratón y el desplazamiento siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une app a activé la saisie sécurisée, qui cache les touches aux apps comme SameKeys : une protection de macOS pour les mots de passe, pas une panne. Les boutons de la souris et le défilement fonctionnent toujours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あるアプリがセキュア入力をオンにしたため、SameKeys のようなアプリにはキー入力が届きません。これはパスワードを守る macOS の仕組みで、不具合ではありません。マウスボタンとスクロールは引き続き使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 앱이 보안 입력을 켰습니다. 보안 입력은 SameKeys 같은 앱에 키 입력을 숨기는 macOS의 암호 보호 기능이며 오류가 아닙니다. 마우스 버튼과 스크롤은 계속 작동합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja włączyła bezpieczne wprowadzanie, które ukrywa naciśnięcia klawiszy przed aplikacjami takimi jak SameKeys — to zabezpieczenie haseł w macOS, a nie usterka. Przyciski myszy i przewijanie nadal działają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um app ativou a entrada segura, que esconde as teclas de apps como o SameKeys: uma proteção do macOS para senhas, não um defeito. Os botões do mouse e a rolagem continuam funcionando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有应用开启了安全输入，系统会对 SameKeys 这类应用隐藏按键——这是 macOS 保护密码的机制，不是故障。鼠标按键和滚动仍然正常。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 App 開啟了安全輸入，系統會對 SameKeys 這類 App 隱藏按鍵——這是 macOS 保護密碼的機制，不是故障。滑鼠按鈕和捲動仍然正常。"
          }
        }
      }
    },
    "Another app already uses this shortcut. Choose a different one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere App nutzt diesen Kurzbefehl schon. Wähle einen anderen."
