    "Come back here. This window moves on by itself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komm hierher zurück. Dieses Fenster geht von selbst weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve aquí. Esta ventana avanza sola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revenez ici. Cette fenêtre passe à la suite toute seule."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここに戻ってきてください。このウインドウは自動で次に進みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기로 돌아오십시오. 이 윈도우는 저절로 다음 단계로 넘어갑니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wróć tutaj. To okno samo przejdzie dalej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volte aqui. Esta janela avança sozinha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回到这里即可，这个窗口会自动进入下一步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回到這裡即可，這個視窗會自動進入下一步。"
          }
        }
