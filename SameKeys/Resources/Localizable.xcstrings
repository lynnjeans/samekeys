    },
    "Older items are dropped once there are more; pinned items are kept" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ältere Einträge fallen weg, sobald es mehr werden; angeheftete bleiben"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los más antiguos se eliminan al haber más; los fijados se conservan"
