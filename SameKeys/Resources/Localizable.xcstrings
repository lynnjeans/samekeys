    "Set in System Settings › Keyboard › Keyboard Shortcuts › Function Keys. A PC keyboard's F-keys already work." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellbar unter Systemeinstellungen › Tastatur › Tastaturkurzbefehle › Funktionstasten. Die F-Tasten einer PC-Tastatur funktionieren bereits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ajusta en Ajustes del Sistema › Teclado › Funciones rápidas de teclado › Teclas de función. Las teclas F de un teclado de PC ya funcionan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À régler dans Réglages Système › Clavier › Raccourcis clavier › Touches de fonction. Les touches F d’un clavier PC marchent déjà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システム設定 › キーボード › キーボードショートカット › ファンクションキー」で設定します。PC キーボードの F キーはそのまま使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 › 키보드 › 키보드 단축키 › 기능 키에서 설정합니다. PC 키보드의 F 키는 이미 작동합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawisz to w Ustawieniach systemowych › Klawiatura › Skróty klawiszowe › Klawisze funkcyjne. Klawisze F klawiatury PC już działają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste em Ajustes do Sistema › Teclado › Atalhos de Teclado › Teclas de Função. As teclas F de um teclado de PC já funcionam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「系统设置 › 键盘 › 键盘快捷键 › 功能键」中设置。PC 键盘的 F 键本来就能直接用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「系統設定 › 鍵盤 › 鍵盤快速鍵 › 功能鍵」中設定。PC 鍵盤的 F 鍵本來就能直接用。"
          }
        }
      }
