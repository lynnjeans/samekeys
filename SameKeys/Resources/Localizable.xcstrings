    "SameKeys is running from its disk image, where it cannot be updated. Drag it to the Applications folder and open it from there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SameKeys läuft aus seinem Image, wo es nicht aktualisiert werden kann. Zieh es in den Ordner „Programme“ und öffne es von dort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SameKeys se está ejecutando desde su imagen de disco, donde no puede actualizarse. Arrástralo a la carpeta Aplicaciones y ábrelo desde allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SameKeys s’exécute depuis son image disque, où il ne peut pas être mis à jour. Faites-le glisser dans le dossier Applications et ouvrez-le depuis là."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SameKeys はディスクイメージから実行されているため、アップデートできません。「アプリケーション」フォルダにドラッグして、そこから開いてください。"
          }
