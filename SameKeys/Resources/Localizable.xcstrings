        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개수를 넘으면 오래된 항목부터 삭제되며, 고정한 항목은 유지됩니다"
          }
        },
        "pl" : {
          "stringUnit" : {
