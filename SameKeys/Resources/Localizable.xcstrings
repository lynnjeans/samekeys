    "SameKeys %@ is ready to install. It installs the next time SameKeys quits." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SameKeys %@ ist bereit. Es wird installiert, wenn SameKeys das nächste Mal beendet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SameKeys %@ está listo para instalarse. Se instalará la próxima vez que salgas de SameKeys."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SameKeys %@ est prêt à être installé. Il s’installera la prochaine fois que SameKeys sera quitté."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SameKeys %@ のインストール準備ができました。次に SameKeys を終了したときにインストールされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
