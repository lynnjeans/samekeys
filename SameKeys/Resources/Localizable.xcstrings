      }
    },
    "Ctrl+C and Ctrl+V copy and paste." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strg+C und Strg+V kopieren und fügen ein."
          }
        },
        "es" : {
