          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O menu de contexto e diálogos de abrir e salvar que pulam para onde o Finder está."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右键菜单，以及能跳到访达当前位置的打开与存储对话框。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右鍵選單，以及能跳到 Finder 目前位置的打開與儲存對話框。"
          }
        }
      }
    },
    "The shortcut could not be set up. Choose a different one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kurzbefehl konnte nicht eingerichtet werden. Wähle einen anderen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido configurar el atajo. Elige otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
