    "Click to record a new one" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken, um einen neuen aufzunehmen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic para grabar uno nuevo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez pour en enregistrer un nouveau"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックして新しく記録"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클릭하여 새로 기록"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij, aby nagrać nowy"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique para gravar um novo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击录制新的"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下以錄製新的"
          }
        }
      }
    },
    "Clicking the Dock icon of the app in front minimizes its window, like a taskbar button on Windows. Click it again to bring the window back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Klick auf das Dock-Symbol der App im Vordergrund minimiert ihr Fenster, wie eine Taskleisten-Schaltfläche unter Windows. Ein weiterer Klick holt das Fenster zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hacer clic en el icono del Dock de la app en primer plano minimiza su ventana, como un botón de la barra de tareas en Windows. Vuelve a hacer clic para recuperar la ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquer sur l’icône du Dock de l’app au premier plan réduit sa fenêtre, comme un bouton de la barre des tâches sous Windows. Cliquez de nouveau pour la faire revenir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最前面のアプリの Dock アイコンをクリックすると、Windows のタスクバーのボタンのようにウインドウが最小化されます。もう一度クリックすると元に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "맨 앞에 있는 앱의 Dock 아이콘을 클릭하면 Windows의 작업 표시줄 버튼처럼 윈도우가 최소화됩니다. 다시 클릭하면 윈도우가 돌아옵니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknięcie ikony w Docku aplikacji na pierwszym planie minimalizuje jej okno, jak przycisk na pasku zadań w Windows. Kliknij ponownie, aby okno wróciło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clicar no ícone do Dock do app em primeiro plano minimiza a janela dele, como um botão da barra de tarefas no Windows. Clique de novo para trazer a janela de volta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按最前面那个应用的程序坞图标，会把它的窗口最小化，就像 Windows 的任务栏按钮。再点一次，窗口就回来了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下最前方 App 的 Dock 圖像，會把它的視窗縮到最小，就像 Windows 的工作列按鈕。再按一下，視窗就回來了。"
          }
        }
      }
    },
