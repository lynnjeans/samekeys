    "The right-click menu, and open and save dialogs that jump to where Finder is." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Kontextmenü und Öffnen- und Sichern-Dialoge, die dorthin springen, wo der Finder ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El menú contextual y diálogos de abrir y guardar que saltan a donde está el Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le menu contextuel, et des dialogues Ouvrir et Enregistrer qui sautent là où est le Finder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右クリックメニューと、Finder の場所へ移動できる開く・保存ダイアログ。"
