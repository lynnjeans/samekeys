    "⌥ sits where the Windows key does, so ⌥ and an arrow places or minimizes the window in front" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥ liegt dort, wo die Windows-Taste ist, also ordnet ⌥ plus Pfeil das Fenster im Vordergrund an oder minimiert es"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥ está donde la tecla Windows, así que ⌥ y una flecha colocan o minimizan la ventana en primer plano"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥ est à la place de la touche Windows, donc ⌥ et une flèche placent ou réduisent la fenêtre au premier plan"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥ は Windows キーと同じ位置にあるため、⌥ と矢印キーで最前面のウインドウを配置または最小化します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥는 Windows 키 자리에 있으므로 ⌥와 화살표로 맨 앞의 윈도우를 배치하거나 최소화합니다"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥ leży tam, gdzie klawisz Windows, więc ⌥ i strzałka układają lub minimalizują okno na pierwszym planie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥ fica onde está a tecla Windows, então ⌥ e uma seta posicionam ou minimizam a janela em primeiro plano"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥ 就在 Windows 键的位置，所以 ⌥ 加方向键即可摆放或最小化最前面的窗口"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥ 就在 Windows 鍵的位置，所以 ⌥ 加方向鍵即可擺放或縮到最小最前方的視窗"
          }
        }
      }
    }
