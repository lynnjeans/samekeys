          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SameKeys działa z obrazu dysku, gdzie nie można go uaktualnić. Przeciągnij go do katalogu Aplikacje i otwórz go stamtąd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O SameKeys está sendo executado a partir da imagem de disco, onde não pode ser atualizado. Arraste-o para a pasta Aplicativos e abra-o de lá."
