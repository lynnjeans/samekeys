    "Paused until %@. Every key, click and scroll reaches apps unchanged until then." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert bis %@. Bis dahin kommt jede Taste, jeder Klick und jedes Scrollen unverändert bei den Apps an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa hasta las %@. Hasta entonces, cada tecla, clic y desplazamiento llega sin cambios a las apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pause jusqu’à %@. D’ici là, chaque touche, clic et défilement arrive tel quel dans les apps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ まで一時停止中。それまではキー、クリック、スクロールがすべてそのままアプリに届きます。"
