          "stringUnit" : {
            "state" : "translated",
            "value" : "Maj+défilement fait défiler latéralement dans la plupart des apps ; avec Maj, ce n’est plus le cas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多くのアプリでは Shift+スクロールで横にスクロールします。Shift を含めるとそれができなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대부분의 앱에서 Shift+스크롤은 가로로 스크롤합니다. Shift를 포함하면 더 이상 그렇게 되지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shift+przewijanie przewija w bok w większości aplikacji; z Shift już tak nie będzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shift+rolagem rola na horizontal na maioria dos apps; com Shift, isso não acontece mais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在大多数应用里 Shift+滚动是横向滚动；包含 Shift 后就不能横向滚动了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在大多數 App 裡 Shift+捲動是橫向捲動；包含 Shift 後就不能橫向捲動了。"
          }
        }
      }
    },
