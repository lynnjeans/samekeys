        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@까지 일시 정지됨. 그때까지 모든 키, 클릭, 스크롤이 그대로 앱에 전달됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstrzymano do %@. Do tego czasu każdy klawisz, kliknięcie i przewinięcie trafia do aplikacji bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
