    "Natural scrolling is off in System Settings, so wheels already scroll this way." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natürliches Scrollen ist in den Systemeinstellungen aus, Mausräder scrollen also schon so."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desplazamiento natural está desactivado en Ajustes del Sistema, así que las ruedas ya se desplazan así."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le défilement naturel est désactivé dans Réglages Système, les molettes défilent donc déjà ainsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定でナチュラルなスクロールがオフなので、ホイールはすでにこの方向です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정에서 자연스러운 스크롤이 꺼져 있으므로 휠은 이미 이 방향으로 스크롤됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naturalne przewijanie jest wyłączone w Ustawieniach systemowych, więc kółka już tak przewijają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rolagem natural está desativada nos Ajustes do Sistema, então as rodas já rolam assim."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统设置里已关闭自然滚动，滚轮本来就是这个方向。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統設定裡已關閉自然捲動，滾輪本來就是這個方向。"
          }
        }
      }
